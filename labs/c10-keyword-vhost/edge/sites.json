{
  "http_addr": ":8080",
  "https_addr": ":8443",
  "cert_file": "/certs/lab.crt",
  "key_file": "/certs/lab.key",
  "default_server": "Microsoft-HTTPAPI/2.0",
  "sites": [
    {
      "host": "chatadmin.corp.lab",
      "upstream": "http://172.28.100.20:80",
      "server": "Microsoft-IIS/10.0",
      "case_insensitive": true,
      "paths": [
        { "prefix": "/chatadmin/", "upstream": "http://172.28.100.20:80", "rewrite": "/chatadmin/" },
        { "prefix": "/chatadmin", "upstream": "http://172.28.100.20:80", "rewrite": "/chatadmin/index.html" },
        { "prefix": "/", "upstream": "http://172.28.100.20:80", "rewrite": "/" }
      ]
    }
  ],
  "keywords": [
    {
      "contains": "portal.",
      "match": "suffix",
      "status": 404,
      "server": "Microsoft-HTTPAPI/2.0"
    },
    {
      "contains": "portal",
      "ignore_case": true,
      "upstream": "http://172.28.100.21:8000",
      "server": "Microsoft-IIS/10.0",
      "app_header": { "X-App": "portal" }
    },
    {
      "contains": "vpn",
      "ignore_case": true,
      "status": 403,
      "body_file": "/sites/403.html",
      "server": "Microsoft-HTTPAPI/2.0"
    }
  ]
}
